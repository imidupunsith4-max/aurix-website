<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>AURIX | Super Boss Level</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@400;700;900&family=Manrope:wght@400;500;700&display=swap" rel="stylesheet">
<style>
:root{--ink:#030818;--deep:#07102e;--volt:#2f7bff;--ice:#bcd8ff;--bone:#eef4ff;--glass:rgba(8,18,52,.62);--line:rgba(120,170,255,.28);
--hd:'Unbounded','Arial Black',sans-serif;--bd:'Manrope','Segoe UI',Arial,sans-serif;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
html{scroll-padding-top:env(safe-area-inset-top,0px);scroll-behavior:smooth}
*,*::before,*::after{box-sizing:inherit}
body{margin:0;background:var(--ink);color:var(--bone);font:400 16px/1.65 var(--bd)}
.bg{position:fixed;inset:0;z-index:-2;background:var(--ink) url(data:image/jpeg;base64,
